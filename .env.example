# Supabase project settings. These are read on the server, never shipped to the browser.
# Enable Google in Supabase Auth and allow <app-origin>/auth/callback as a redirect.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
# Optional project reference; auth uses getUser() for server-verified identity.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Files browser. Server-only; npm run dev enables it by default.
# Production remains disabled by default until hosted Batch 11 acceptance.
# Uncomment to disable the local browser; restart after changing this setting.
# FILES_BROWSER_ENABLED=false

# AI pilot. Server-only. Keep disabled until both AI migrations are installed.
GEMINI_API_KEY=
AI_ENABLED=false
AI_DATA_MODE=synthetic
# Explicit comma-separated profile UUIDs. Empty denies all accounts.
AI_ALLOWED_PROFILE_IDS=
AI_CHAT_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
# Shared provider-call budgets; configure at or below your AI Studio quotas.
AI_USER_DAILY_REQUESTS=30
AI_PROJECT_DAILY_REQUESTS=100
AI_PROJECT_RPM=10
AI_PROJECT_TPM=300000
AI_MONTHLY_BUDGET_USD=25
# Conservative billing defaults. Thinking tokens count as output.
AI_INPUT_USD_PER_MILLION=1.5
AI_OUTPUT_USD_PER_MILLION=7.5

# Supabase project settings. These are read on the server, never shipped to the browser.
# Enable Google in Supabase Auth and allow <app-origin>/auth/callback as a redirect.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
# Optional project reference; auth uses getUser() for server-verified identity.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
